# Flask
SECRET_KEY=change-me-in-production
FLASK_ENV=development
HOST=127.0.0.1
PORT=5001

# AWS API Gateway
AWS_API_BASE_URL=https://your-api-id.execute-api.ap-southeast-2.amazonaws.com
AWS_REGION=ap-southeast-2
CLOUD_TIMEOUT_SECONDS=12
DASHBOARD_CLOUD_TIMEOUT=15

# Device ingest security — must match Lambda env DEVICE_API_KEY
DEVICE_API_KEY=your-device-api-key

# Device identity
DEVICE_ID=pi-001
SENSOR_INTERVAL=5

# SNS email alerts (Lambda env only, not used by Flask)
# SNS_TOPIC_ARN=arn:aws:sns:ap-southeast-2:123456789012:env-alerts
# ALERT_COOLDOWN_SECONDS=600

# Sensor backend
SENSOR_BACKEND=sense_emu
USE_MOCK_SENSOR=0

# Background collector (off by default; use device/emulator_uploader.py)
ENABLE_BACKGROUND_COLLECTOR=false

# Auth bypass — only works when FLASK_ENV=development
# DISABLE_AUTH=1
