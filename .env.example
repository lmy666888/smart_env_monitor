# Flask
SECRET_KEY=change-me-in-production
FLASK_ENV=development
HOST=127.0.0.1
PORT=5001

# AWS Brain (default: true)
USE_AWS_BRAIN=true
AWS_API_BASE_URL=https://9jzbd9a34j.execute-api.ap-southeast-2.amazonaws.com
AWS_REGION=ap-southeast-2
CLOUD_TIMEOUT_SECONDS=12
DASHBOARD_CLOUD_TIMEOUT=15

# Optional overrides (full URLs)
# AWS_DATA_URL=
# AWS_INGEST_URL=
# AWS_SETTINGS_URL=
# AWS_LOGIN_URL=
# AWS_REGISTER_URL=
# AWS_HEALTH_URL=

# Device
DEVICE_ID=pi-001
SENSOR_INTERVAL=5

# Flask background upload loop (default off — use device/emulator_uploader.py for cloud demo)
ENABLE_BACKGROUND_COLLECTOR=false

# Auth — credentials live in DynamoDB Users (via POST /login)
DISABLE_AUTH=0

# Local fallback only when AWS is down (optional)
LOCAL_FALLBACK_ON_AWS_ERROR=false
USE_SQLITE_CACHE=false

# Sensor / dev
USE_MOCK_SENSOR=0
SENSOR_BACKEND=sense_emu
