# Flask
SECRET_KEY=change-me-in-production
FLASK_ENV=production
HOST=127.0.0.1
PORT=5001

# AWS API Gateway (BFF proxies these endpoints)
AWS_API_BASE_URL=https://9jzbd9a34j.execute-api.ap-southeast-2.amazonaws.com
AWS_REGION=ap-southeast-2
CLOUD_TIMEOUT_SECONDS=12
DASHBOARD_CLOUD_TIMEOUT=15

# Optional full URL overrides
# AWS_DATA_URL=
# AWS_INGEST_URL=
# AWS_SETTINGS_URL=
# AWS_LOGIN_URL=
# AWS_REGISTER_URL=
# AWS_HEALTH_URL=

# Device ingest security (set same value on Lambda DEVICE_API_KEY)
DEVICE_API_KEY=smart-env-pi001-key

# SNS email alerts (set on get_dashboard_data Lambda, not Flask)
# SNS_TOPIC_ARN=arn:aws:sns:ap-southeast-2:123456789012:env-alerts
# ALERT_COOLDOWN_SECONDS=600
# ALERT_STATE_TABLE_NAME=AlertState
USE_AWS_BRAIN=True
# Device
DEVICE_ID=pi-001
SENSOR_INTERVAL=5

# Flask background upload (default off — use device/emulator_uploader.py)
ENABLE_BACKGROUND_COLLECTOR=false

# Demo mock uploads (off for real emulator demos)
DEMO_MODE=false
MOCK_UPLOAD_ENABLED=false

# Auth: login required by default. Bypass only in development:
# FLASK_ENV=development
# DISABLE_AUTH=1

# Sensor
USE_MOCK_SENSOR=0
SENSOR_BACKEND=sense_emu
